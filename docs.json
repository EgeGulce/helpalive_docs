              "dashboard/setup",
              "dashboard/billing",
              "dashboard/privacy-management",
              "dashboard/account"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "code",
        "groups": [
          {
            "group": "Install",
            "pages": [
              "sdk/overview",
              "installation",
              "sdk/identify",
              "sdk/verify-users",
              "sdk/ai-coding-agents"
            ]
          },
          {
            "group": "Install by framework",
            "pages": [
              "sdk/react",
              "sdk/nextjs",
              "sdk/vue",
              "sdk/angular",
              "sdk/html"
            ]
          },
          {
            "group": "Install options and security",
            "pages": [
              "sdk/google-tag-manager",
              "sdk/csp",
              "sdk/consent",
              "sdk/agent-ready"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "sdk/reference",
              "sdk/troubleshooting"
            ]
          }
        ]
      },
      {
        "tab": "Trust",
        "icon": "shield-check",
        "groups": [
          {
            "group": "Security and privacy",
            "pages": [
              "trust/security",
              "trust/data",
              "trust/ai-and-your-data",
              "trust/subprocessors"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://helpalive.com",
