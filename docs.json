{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HelpAlive",
  "description": "HelpAlive is an AI agent for every user in your SaaS — context-aware answers, in-app guides, and adoption insights, from one script tag.",
  "colors": {
    "primary": "#3FACF8",
    "light": "#68cbe9",
    "dark": "#1494f0"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "HelpAlive Documentation",
      "og:image": "/logo/icon.svg",
      "twitter:card": "summary_large_image",
      "twitter:site": "@HelpAliveAI",
      "robots": "index, follow",
      "author": "HelpAlive"
    }
  },
  "search": {
    "prompt": "Search the docs..."
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign up for early access",
      "href": "https://helpalive.com/#early-access"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "introduction",
          "quickstart",
          "installation",
          "use-cases"
        ]
      },
      {
        "group": "SDK",
        "icon": "code",
        "pages": [
          "sdk/overview",
          "sdk/identify",
          "sdk/consent"
        ]
      },
      {
        "group": "Agent",
        "icon": "messages-square",
        "pages": [
          "agent/overview",
          "agent/train",
          "agent/appearance",
          "agent/publishing"
        ]
      },
      {
        "group": "Studio",
        "icon": "wand-sparkles",
        "pages": [
          "studio/overview",
          "studio/pages",
          "studio/topics",
          "studio/guides"
        ]
      },
      {
        "group": "Insight",
        "icon": "compass",
        "pages": [
          "insight/overview",
          "insight/audience"
        ]
      },
      {
        "group": "Privacy",
        "icon": "shield-check",
        "pages": [
          "privacy/overview",
          "privacy/redaction",
          "privacy/dsar"
        ]
      },
      {
        "group": "Plans",
        "icon": "credit-card",
        "pages": [
          "plans/overview",
          "plans/faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://helpalive.com",
      "x": "https://x.com/HelpAliveAI",
      "linkedin": "https://www.linkedin.com/company/helpalive"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "SDK", "href": "/sdk/overview" },
          { "label": "Agent", "href": "/agent/overview" },
          { "label": "Studio", "href": "/studio/overview" },
          { "label": "Insight", "href": "/insight/overview" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Use cases", "href": "/use-cases" },
          { "label": "Privacy", "href": "/privacy/overview" },
          { "label": "Plans", "href": "/plans/overview" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "Website", "href": "https://helpalive.com" },
          { "label": "Dashboard", "href": "https://app.helpalive.com" },
          { "label": "Sign up for early access", "href": "https://helpalive.com/#early-access" }
        ]
      }
    ]
  }
}
