{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "HelpAlive",
  "description": "HelpAlive is your best product advisor — an AI agent that watches every user inside your SaaS, intervenes when they're stuck, and answers in context when they ask.",
  "colors": {
    "primary": "#3FACF8",
    "light": "#68cbe9",
    "dark": "#1494f0"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:type": "website",
      "og:site_name": "HelpAlive Documentation",
      "og:image": "/logo/icon.svg",
      "twitter:card": "summary_large_image",
      "twitter:site": "@helpalive",
      "robots": "index, follow",
      "author": "HelpAlive"
    }
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "helpalive.com",
        "href": "https://helpalive.com"
      },
      {
        "label": "Dashboard",
        "href": "https://app.helpalive.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Early Access",
      "href": "https://helpalive.com/contact"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "https://helpalive.com/contact"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "introduction",
          "quickstart",
          "installation",
          "use-cases",
          "compare"
        ]
      },
      {
        "group": "SDK",
        "icon": "code",
        "pages": [
          "sdk/overview",
          "sdk/identify",
          "sdk/api-reference",
          "sdk/consent"
        ]
      },
      {
        "group": "Chatbot",
        "icon": "sparkles",
        "pages": [
          "chatbot/overview",
          "chatbot/knowledge-base",
          "chatbot/appearance",
          "chatbot/draft-publish"
        ]
      },
      {
        "group": "Analytics",
        "icon": "chart-line",
        "pages": [
          "analytics/overview",
          "analytics/coverage-gaps",
          "analytics/user-profiles"
        ]
      },
      {
        "group": "Guides",
        "icon": "map",
        "pages": [
          "guides/overview"
        ]
      },
      {
        "group": "Privacy",
        "icon": "shield-check",
        "pages": [
          "privacy/overview",
          "privacy/redaction",
          "privacy/dsar"
        ]
      },
      {
        "group": "Plans",
        "icon": "credit-card",
        "pages": [
          "plans/overview",
          "plans/faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://helpalive.com",
      "x": "https://x.com/helpalive"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "SDK", "href": "/sdk/overview" },
          { "label": "AI chatbot", "href": "/chatbot/overview" },
          { "label": "Compare", "href": "/compare" }
        ]
      },
      {
        "header": "Resources",
        "items": [
          { "label": "Use cases", "href": "/use-cases" },
          { "label": "Privacy", "href": "/privacy/overview" },
          { "label": "Plans", "href": "/plans/overview" }
        ]
      },
      {
        "header": "Company",
        "items": [
          { "label": "Website", "href": "https://helpalive.com" },
          { "label": "Dashboard", "href": "https://app.helpalive.com" },
          { "label": "Contact", "href": "https://helpalive.com/contact" }
        ]
      }
    ]
  }
}
