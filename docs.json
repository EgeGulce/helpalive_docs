{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "HelpAlive",
  "description": "HelpAlive is your best product advisor — an AI assistant inside your product plus adoption insights for your team.",
  "colors": {
    "primary": "#3FACF8",
    "light": "#68cbe9",
    "dark": "#1494f0"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.helpalive.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Early Access",
      "href": "https://helpalive.com/contact"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Help",
          "icon": "life-buoy",
          "href": "https://helpalive.com/contact"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "introduction",
          "quickstart",
          "installation"
        ]
      },
      {
        "group": "SDK",
        "icon": "code",
        "pages": [
          "sdk/overview",
          "sdk/identify",
          "sdk/api-reference",
          "sdk/consent"
        ]
      },
      {
        "group": "Chatbot",
        "icon": "sparkles",
        "pages": [
          "chatbot/overview",
          "chatbot/knowledge-base",
          "chatbot/appearance",
          "chatbot/draft-publish"
        ]
      },
      {
        "group": "Analytics",
        "icon": "chart-line",
        "pages": [
          "analytics/overview",
          "analytics/coverage-gaps",
          "analytics/user-profiles"
        ]
      },
      {
        "group": "Guides",
        "icon": "map",
        "pages": [
          "guides/overview"
        ]
      },
      {
        "group": "Privacy",
        "icon": "shield-check",
        "pages": [
          "privacy/overview",
          "privacy/redaction",
          "privacy/dsar"
        ]
      },
      {
        "group": "Plans",
        "icon": "credit-card",
        "pages": [
          "plans/overview",
          "plans/faq"
        ]
      }
    ]
  },
  "footer": {
    "socials": {}
  }
}
