{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "HelpAlive",
  "description": "HelpAlive is an AI agent inside your web app: it answers your users' questions from your docs and does tasks for them or shows them how. One script and one identify() call.",
  "colors": {
    "primary": "#3FACF8",
    "light": "#68cbe9",
    "dark": "#1494f0"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "HelpAlive",
      "twitter:card": "summary_large_image",
      "twitter:site": "@HelpAliveAI",
      "robots": "index, follow",
      "author": "HelpAlive"
    }
  },
  "search": {
    "prompt": "Search the docs..."
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "label": "Dashboard",
        "href": "https://app.helpalive.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://app.helpalive.com/signup"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Product",
        "icon": "sparkles",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "product/how-it-works",
              "product/compare",
              "product/concepts"
            ]
          },
          {
            "group": "What your users get",
            "pages": [
              "product/chat",
              "product/assists",
              "product/nudges",
              "product/what-it-wont-do"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "product/faq",
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "Dashboard",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "quickstart",
              "dashboard/home"
            ]
          },
          {
            "group": "Your agent",
            "pages": [
              "dashboard/train",
              "dashboard/test",
              "dashboard/appearance",
              "dashboard/publishing",
              "dashboard/controls",
              "dashboard/usage"
            ]
